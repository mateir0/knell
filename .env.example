# Knell talks to any OpenAI-compatible chat completions endpoint.

# Base URL of the endpoint, without the /chat/completions suffix.
# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1

# Model tag sent to the endpoint.
# Local Ollama default:
LLM_MODEL=gemma3:4b

# Optional. Leave empty for local Ollama.
# Set it when using a hosted open-weight endpoint that requires a key.
LLM_API_KEY=

# Required for the sweep. Get a key at serpapi.com (free tier: 100 searches / month).
SERPAPI_API_KEY=

# Optional fallback search provider (serper.dev, 2,500 free queries);
# used automatically when SerpApi is unconfigured, exhausted, or returns nothing.
SERPER_API_KEY=

# The graveyard (MongoDB Atlas, free M0). Every real verdict is buried here and
# repeat checks are served from memory for free.
# Atlas connection string; the graveyard is disabled when unset.
MONGODB_URI=

# Optional, defaults to knell.
MONGODB_DB=

# Optional — the judge model slot. When empty, the LLM_* values are used.
# Set JUDGE_MODEL to a Gemma model to make Gemma the judge.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Optional. Defaults to 0.2; set 0.5 when the judge provider is Inception Mercury
# (its API range is 0.5-1.0).
JUDGE_TEMPERATURE=

# Sentry (error monitoring + agent tracing). Disabled when unset.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Used only by scripts/tinker (the judge fine-tune loop), never by the web app.
# Get a key at tinker.thinkingmachines.ai.
TINKER_API_KEY=
