# Knell talks to any OpenAI-compatible chat completions endpoint.

# Base URL of the endpoint, without the /chat/completions suffix.
# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1

# Model tag sent to the endpoint.
# Local Ollama default:
LLM_MODEL=gemma3:4b

# Optional. Leave empty for local Ollama.
# Set it when using a hosted open-weight endpoint that requires a key.
LLM_API_KEY=
